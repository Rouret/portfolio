---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PostHead from '@/components/PostHead.astro'
import CoverImage from '@/components/CoverImage.astro'
import PostNavigation from '@/components/PostNavigation.astro'
import TableOfContents from '@/components/TableOfContents.astro'
import { Button, buttonVariants } from '@/components/ui/button'
import Layout from '@/layouts/Layout.astro'
import { getAdjacentArticles, getAllArticles } from '@/lib/data-utils'
import { formatDate, readingTime, slugifyTag } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getAllArticles()
  return posts.map((post) => ({
    params: { id: post.slug },
    props: post,
  }))
}

const post = Astro.props
const currentPostSlug = Astro.params.id

const { Content, headings } = await render(post)
const { next, prev } = await getAdjacentArticles(currentPostSlug)

const canonicalUrl = new URL(`/articles/${post.slug}/`, Astro.site).toString()
const shareUrl = encodeURIComponent(canonicalUrl)
const shareLinks = [
  { name: 'Facebook', icon: 'line-md:facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}` },
  { name: 'Twitter', icon: 'line-md:twitter', href: `https://twitter.com/intent/tweet?url=${shareUrl}` },
  { name: 'LinkedIn', icon: 'line-md:linkedin', href: `https://www.linkedin.com/shareArticle?mini=true&url=${shareUrl}` },
  { name: 'Reddit', icon: 'line-md:reddit-loop', href: `https://www.reddit.com/submit?url=${shareUrl}` },
  { name: 'WhatsApp', icon: 'mdi:whatsapp', href: `https://wa.me/?text=${shareUrl}` },
  { name: 'Telegram', icon: 'line-md:telegram', href: `https://t.me/share/url?url=${shareUrl}` },
  { name: 'Pinterest', icon: 'mdi:pinterest', href: `https://pinterest.com/pin/create/button/?url=${shareUrl}` },
]
---

<Layout canonicalUrl={canonicalUrl}>
  <PostHead slot="head" post={post} />

  <div class="flex flex-col gap-10">
    <Breadcrumbs
      items={[
        { href: '/blog', label: 'Blog', icon: 'lucide:archive' },
        { label: post.data.title, icon: 'lucide:file-text' },
      ]}
    />

    <header class="flex max-w-4xl flex-col gap-6">
      <p class="text-muted-foreground flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <span>{readingTime(post.body!)}</span>
        <span>
          By{' '}
          <a href="/" class="hover:text-foreground underline">
            Lucas Rouret
          </a>
        </span>
      </p>
      <h1 class="font-custom text-foreground text-4xl leading-[1.1] font-bold text-pretty break-words sm:text-6xl">
        {post.data.title}
      </h1>
      {post.data.description && (
        <p class="text-muted-foreground text-lg">{post.data.description}</p>
      )}
      {post.data.tags && post.data.tags.length > 0 && (
        <ul class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <li>
              <a
                href={`/tags/${slugifyTag(tag)}`}
                class="border-border text-muted-foreground hover:border-foreground hover:text-foreground inline-flex min-h-9 items-center rounded-full border px-3 text-sm transition-colors"
              >
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    {post.data.image && (
      <CoverImage
        src={post.data.image}
        width={1600}
        height={900}
        loading="eager"
        class="border-border aspect-[16/9] w-full rounded-2xl border object-cover"
      />
    )}

    <div class="mx-auto flex w-full max-w-3xl flex-col gap-y-8">
      {headings.length > 0 && <TableOfContents headings={headings} />}

      <article class="prose max-w-none" aria-label="Blog post">
        <Content />
      </article>

      <aside class="border-border bg-card rounded-2xl border p-6">
        <h2 class="font-custom text-foreground text-2xl font-bold">Share this post</h2>
        <p class="text-muted-foreground mb-4 text-sm">
          If you found this post helpful, consider sharing it with your friends or on social media. Your support helps me
          create more content like this.
        </p>
        <ul class="flex flex-wrap gap-2">
          {
            shareLinks.map(({ name, icon, href }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Share on ${name}`}
                  title={`Share on ${name}`}
                  class={buttonVariants({ variant: 'outline', size: 'icon' })}
                >
                  <Icon name={icon} class="size-4" />
                </a>
              </li>
            ))
          }
        </ul>
      </aside>

      <PostNavigation prevPost={prev} nextPost={next} />
    </div>
  </div>

  <Button
    variant="outline"
    size="icon"
    className="group fixed right-8 bottom-8 z-50 hidden"
    id="scroll-to-top"
    title="Scroll to top"
    aria-label="Scroll to top"
  >
    <Icon
      name="lucide:arrow-up"
      class="mx-auto size-4 transition-all group-hover:-translate-y-0.5"
    />
  </Button>

  <script>
    document.addEventListener('astro:page-load', () => {
      const scrollToTopButton = document.getElementById('scroll-to-top')
      const footer = document.querySelector('footer')

      if (scrollToTopButton && footer) {
        scrollToTopButton.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' })
        })

        window.addEventListener('scroll', () => {
          const footerRect = footer.getBoundingClientRect()
          const isFooterVisible = footerRect.top <= window.innerHeight

          scrollToTopButton.classList.toggle(
            'hidden',
            window.scrollY <= 300 || isFooterVisible,
          )
        })
      }
    })
  </script>
</Layout>
