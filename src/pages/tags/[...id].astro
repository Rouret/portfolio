---
import ArticleCard from '@/components/ArticleCard.astro'
import PageHead from '@/components/PageHead.astro'
import PageHeader from '@/components/PageHeader.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getArticlesByTag } from '@/lib/data-utils'
import { slugifyTag } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

export async function getStaticPaths() {
  const tagMap = await getAllTags()
  return Promise.all(
    Array.from(tagMap.keys()).map(async (tag) => ({
      params: { id: slugifyTag(tag) },
      props: { tag, posts: await getArticlesByTag(tag) },
    })),
  )
}

const { tag, posts } = Astro.props
---

<Layout canonicalUrl={Astro.url}>
  <PageHead
    slot="head"
    title={`Articles about ${tag}`}
    description={`Every article tagged ${tag} on Lucas Rouret's blog.`}
  />

  <div class="flex flex-col gap-12">
    <PageHeader title={`#${tag}`}>
      <a slot="above" href="/tags" class="text-muted-foreground hover:text-foreground inline-flex min-h-11 w-fit items-center gap-1 text-sm">
        <Icon name="lucide:arrow-left" class="size-4" /> All tags
      </a>
      {`${posts.length} ${posts.length === 1 ? 'article' : 'articles'}`}
    </PageHeader>

    <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <li>
            <ArticleCard article={post} />
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
