---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import ScreenshotPanel from '@/components/ScreenshotPanel.astro'
import { buttonVariants } from '@/components/ui/button'
import SectionHeading from '@/components/SectionHeading.astro'
import Layout from '@/layouts/Layout.astro'
import { SITE } from '@/consts'
import { getAllProjects, projectLabel } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const projects = await getAllProjects()
  return projects.map((project) => ({
    params: { id: project.id },
    props: project,
  }))
}

const project = Astro.props
const { Content } = await render(project)
const { name, pitch } = project.data

const currentUrl = Astro.url
const currentUrlString = currentUrl.toString()

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  headline: `${name}: ${pitch}`,
  name,
  url: currentUrlString,
  mainEntityOfPage: { '@type': 'WebPage', '@id': currentUrlString },
  inLanguage: SITE.locale,
  datePublished: project.data.startDate,
  dateModified: project.data.endDate ?? project.data.startDate,
  author: { '@id': `${SITE.href}/#person` },
  creator: { '@id': `${SITE.href}/#person` },
  image: new URL(`/image/${project.id}.png`, Astro.site).toString(),
  keywords: project.data.tags.join(', '),
  description: project.data.description,
  about: project.data.tags.map((tag) => ({ '@type': 'Thing', name: tag })),
  ...(project.data.link && { sameAs: project.data.link }),
}
---

<Layout>
  <PageHead
    slot="head"
    title={name}
    description={project.data.description}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />
  <div class="flex flex-col gap-10 pb-28">
    <Breadcrumbs
      items={[
        { href: '/projects', label: 'Projects', icon: 'lucide:folder' },
        { label: name, icon: 'lucide:folder-open' },
      ]}
    />
    <header class="flex flex-col gap-6 pt-6 sm:pt-12">
      <p class="text-muted-foreground text-sm">
        {projectLabel(project)}
      </p>
      <SectionHeading as="h1">{name}.</SectionHeading>
      <p class="text-muted-foreground max-w-2xl text-lg">{pitch}</p>
      {
        project.data.link && (
          <a
            href={project.data.link}
            target="_blank"
            rel="noopener"
            class={buttonVariants({ variant: 'contrast', size: 'pill', className: 'w-fit' })}
          >
            Visit website <Icon name="lucide:arrow-up-right" class="size-4" />
          </a>
        )
      }
    </header>

    <ScreenshotPanel src={project.data.image} alt={name} loading="eager" class="rounded-2xl" />

    <article class="prose max-w-3xl" aria-label="Project">
      <Content />
    </article>
  </div>
</Layout>
