---
import LatestArticles from '@/components/LatestArticles.astro'
import PageHead from '@/components/PageHead.astro'
import NotesExplorer from '@/components/react/notes-explorer'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllArticles, getAllProjects } from '@/lib/data-utils'
import { notesTree } from '@/lib/notes'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

import me from '../assets/me.jpg'

const currentUrl = Astro.url
const projects = await getAllProjects()
const currentProject = projects.find((project) => project.id === 'lyn-meteo')
const allArticles = await getAllArticles()
---

<Layout canonicalUrl={currentUrl}>
  <PageHead slot="head" title="Confirmé Full Stack Developer" />
  <section class="flex flex-col gap-y-12 px-4 py-8 sm:px-8 lg:px-16">
    <div
      class="flex flex-col items-center text-center sm:flex-row sm:items-start sm:gap-8 sm:text-left"
    >
      <div
        class="relative overflow-hidden rounded-lg sm:shrink-0 sm:overflow-hidden sm:rounded-lg"
      >
        <Image
          src={me}
          alt="Logo"
          width={200}
          height={200}
          class="relative overflow-hidden rounded-lg sm:shrink-0 sm:overflow-hidden sm:rounded-lg"
        />
      </div>
      <div class="mt-8 sm:mt-0 sm:max-w-xl">
        <h1
          class="font-custom text-foreground text-start text-4xl font-extrabold sm:text-5xl"
        >
          {SITE.title}
        </h1>
        <div class="mt-4 flex items-center gap-2" aria-label="location">
          <span
            class="bg-primary text-primary-foreground ring-primary/30 rounded-full px-3 py-1 text-sm font-medium ring-1"
          >
            I'm from
          </span>
          <span class="flex items-center gap-1">
            <span class="text-foreground text-sm font-medium">
              {SITE.location}</span
            >
            <svg
              viewBox="0 0 36 36"
              class="h-6 w-6 transition-transform duration-500 hover:rotate-12"
              aria-hidden="true"
              role="img"
              focusable="false"
              aria-labelledby="title"
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
              aria-hidden="true"
              role="img"
              class="iconify iconify--twemoji"
              preserveAspectRatio="xMidYMid meet"
              fill="#000000"
              ><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g
                id="SVGRepo_tracerCarrier"
                stroke-linecap="round"
                stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"
                ><path
                  fill="#ED2939"
                  d="M36 27a4 4 0 0 1-4 4h-8V5h8a4 4 0 0 1 4 4v18z"></path><path
                  fill="#002495"
                  d="M4 5a4 4 0 0 0-4 4v18a4 4 0 0 0 4 4h8V5H4z"></path><path
                  fill="#EEE"
                  d="M12 5h12v26H12z"></path></g
              ></svg
            >
          </span>
        </div>
        <p
          class="text-md text-foreground mt-4 text-start font-sans"
          title="description"
          aria-label="description"
        >
          {SITE.description}
        </p>
      </div>
    </div>

    {
      currentProject && (
        <section class="relative" aria-labelledby="current-project-title">
          <h2
            id="current-project-title"
            class="font-custom text-foreground text-2xl font-bold"
            title="current project"
            aria-label="current project"
            role="heading"
          >
            What I'm Working On
          </h2>
          <p
            class="text-muted-foreground text-sm"
            aria-label="current project description"
          >
            Outside of my day job, this is the project I'm currently pouring my
            time into.
          </p>
          <a
            href={`/projects/${currentProject.id}`}
            class="group bg-card border-card-foreground/10 mt-4 flex flex-col overflow-hidden rounded-2xl border transition-all duration-300 hover:shadow-lg sm:flex-row"
            aria-label={`See ${currentProject.data.name} project`}
          >
            <div class="aspect-[16/10] w-full overflow-hidden sm:w-72 sm:shrink-0">
              <Image
                alt={currentProject.data.name}
                src={currentProject.data.image}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                width={600}
                height={375}
              />
            </div>
            <div class="flex flex-1 flex-col justify-between p-5">
              <div>
                <h3 class="text-foreground mb-2 text-xl font-medium">
                  {currentProject.data.name}
                </h3>
                <p class="text-muted-foreground mb-4 text-sm">
                  {currentProject.data.description}
                </p>
              </div>
              <div class="flex flex-wrap gap-2">
                {currentProject.data.tags?.map((tag) => (
                  <span class="bg-primary/10 text-primary rounded-full px-2 py-1 text-xs font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            <div class="flex items-center p-5 sm:pl-0">
              <Icon
                name="lucide:arrow-right"
                class="size-5 transition-transform group-hover:translate-x-1"
              />
            </div>
          </a>
        </section>
      )
    }

    <LatestArticles />

    <section class="flex flex-col gap-y-4" aria-labelledby="notes-title">
      <div>
        <h2
          id="notes-title"
          class="font-custom text-foreground text-2xl font-bold"
        >
          Explore by Topic
        </h2>
        <p class="text-muted-foreground text-sm">
          Articles grouped around the subjects I keep coming back to.
        </p>
      </div>
      <NotesExplorer client:load notes={notesTree} articles={allArticles} />
    </section>
  </section>
</Layout>
