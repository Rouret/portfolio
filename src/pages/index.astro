---
import LastPersonalBlogPosts from '@/components/LastPersonalBlogPosts.astro'
import LastTechBlogPosts from '@/components/LastTechBlogPosts.astro'
import PageHead from '@/components/PageHead.astro'
import Skills from '@/components/react/skills'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { Image } from 'astro:assets'

import me from '../assets/me.jpg'

const currentUrl = Astro.url
---

<Layout canonicalUrl={currentUrl}>
  <PageHead slot="head" title="Junior Full Stack Developer" />
  <section class="flex flex-col gap-y-12 px-4 py-8 sm:px-8 lg:px-16">
    <div
      class="flex flex-col items-center text-center sm:flex-row sm:items-start sm:gap-8 sm:text-left"
    >
      <div
        class="relative overflow-hidden rounded-lg sm:shrink-0 sm:overflow-hidden sm:rounded-lg"
      >
        <Image
          src={me}
          alt="Logo"
          width={200}
          height={200}
          class="relative overflow-hidden rounded-lg sm:shrink-0 sm:overflow-hidden sm:rounded-lg"
        />
      </div>
      <div class="mt-8 sm:mt-0 sm:max-w-xl">
        <h1
          class="font-custom text-foreground text-start text-4xl font-extrabold sm:text-5xl"
        >
          {SITE.title}
        </h1>
        <div class="mt-4 flex items-center gap-2" aria-label="location">
          <span
            class="bg-primary text-primary-foreground ring-primary/30 rounded-full px-3 py-1 text-sm font-medium ring-1"
          >
            I'm from
          </span>
          <span class="flex items-center gap-1">
            <span class="text-foreground text-sm font-medium">
              {SITE.location}</span
            >
            <svg
              viewBox="0 0 36 36"
              class="h-6 w-6 transition-transform duration-500 hover:rotate-12"
              aria-hidden="true"
              role="img"
              focusable="false"
              aria-labelledby="title"
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
              aria-hidden="true"
              role="img"
              class="iconify iconify--twemoji"
              preserveAspectRatio="xMidYMid meet"
              fill="#000000"
              ><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g
                id="SVGRepo_tracerCarrier"
                stroke-linecap="round"
                stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"
                ><path
                  fill="#ED2939"
                  d="M36 27a4 4 0 0 1-4 4h-8V5h8a4 4 0 0 1 4 4v18z"></path><path
                  fill="#002495"
                  d="M4 5a4 4 0 0 0-4 4v18a4 4 0 0 0 4 4h8V5H4z"></path><path
                  fill="#EEE"
                  d="M12 5h12v26H12z"></path></g
              ></svg
            >
          </span>
        </div>
        <p
          class="text-md text-foreground mt-4 text-start font-sans"
          title="description"
          aria-label="description"
        >
          {SITE.description}
        </p>
      </div>
    </div>

    <section class="relative" aria-labelledby="skills-title">
      <h2
        id="skills-title"
        class="font-custom text-foreground text-2xl font-bold"
        title="skills"
        aria-label="skills"
        role="heading"
      >
        Current Job
      </h2>
      <p class="text-muted-foreground text-sm" aria-label="skills description">
        I graduated in 2023 and work full-time as a software engineer at
        <a
          href="https://apps.theodo.com/a-propos"
          target="_blank"
          class="text-primary">Theodo Apps</a
        >. I am seeking full remote opportunities as a solo developer or with a
        team that wants to learn from their mistakes
      </p>
      <div></div>
    </section>

    <section class="relative" aria-labelledby="skills-title">
      <h2
        id="skills-title"
        class="font-custom text-foreground text-2xl font-bold"
        title="skills"
        aria-label="skills"
        role="heading"
      >
        Skills & Technologies
      </h2>
      <p class="text-muted-foreground text-sm" aria-label="skills description">
        My professional projects have been primarily built with these
        technologies. I'm always eager to learn and adapt, and I also have
        experience with other tools such as: Python, NestJS, ElysiaJS, Spring
        Boot.
      </p>
      <div>
        <Skills client:load />
      </div>
    </section>

    <LastTechBlogPosts />
    <LastPersonalBlogPosts />
  </section>
</Layout>
