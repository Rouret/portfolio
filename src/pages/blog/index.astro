---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import ArticleManager from '@/components/react/article-manager'
import Layout from '@/layouts/Layout.astro'
import { getAllArticles } from '@/lib/data-utils'
import { notesTree } from '@/lib/notes'

const allArticles = await getAllArticles()

const currentUrl = Astro.url
---

<Layout canonicalUrl={currentUrl}>
  <PageHead
    slot="head"
    title="Blog"
    description="Technical articles and personal reflections on web development, programming, and software engineering."
    includeBlogList={true}
  />

  <Breadcrumbs
    items={[{ label: 'Blog', href: '/blog', icon: 'lucide:folder-open' }]}
  />

  <section class="max-screen mt-12 px-4 md:px-6">
    <h2 class="font-custom text-foreground mt-2 text-4xl font-bold">Blog</h2>
    <p class="text-muted-foreground text-md mt-3 max-w-2xl">
      Technical articles and personal reflections all in one place.
    </p>
  </section>

  <div
    class="my-12 flex min-h-[calc(100vh-18rem)] flex-col gap-y-8 px-4 md:px-6"
  >
    <ArticleManager client:load articles={allArticles} notes={notesTree} />
  </div>
</Layout>
