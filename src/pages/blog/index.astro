---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Search from '@/components/react/search'
import Layout from '@/layouts/Layout.astro'
import { getAllPersonalPosts } from '@/lib/data-utils'
import { getAllTechPosts } from '@/lib/hashnode'

const personalPosts = await getAllPersonalPosts()
const techPosts = await getAllTechPosts()

const allPosts = [...personalPosts, ...techPosts].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

const currentUrl = Astro.url
---

<Layout canonicalUrl={currentUrl}>
  <PageHead slot="head" title="Blog" />

  <Breadcrumbs
    items={[{ label: 'Blog', href: '/blog', icon: 'lucide:folder-open' }]}
  />

  <section class="max-screen mt-12 px-4 md:px-6">
    <h2 class="font-custom text-foreground mt-2 text-4xl font-bold">
      Blog
    </h2>
    <p class="text-muted-foreground text-md mt-3 max-w-2xl">
      Technical articles and personal reflections — all in one place.
    </p>
  </section>

  <div class="my-12 flex min-h-[calc(100vh-18rem)] flex-col gap-y-8 px-4 md:px-6">
    <Search client:load searchList={allPosts} initialPosts={allPosts} showCollectionFilter={true} />
  </div>
</Layout>
