---
import SectionHeading from '@/components/SectionHeading.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<header class="flex flex-col gap-4 pt-6 sm:pt-10">
  <slot name="above" />
  <SectionHeading as="h1" class="break-words">{title}</SectionHeading>
  <p class="text-muted-foreground max-w-2xl text-lg"><slot /></p>
</header>
