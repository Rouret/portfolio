---
import Link from '@/components/Link.astro'
import BlogCard from '@/components/react/blog-card'
import { buttonVariants } from '@/components/ui/button'
import { getRecentPersonalPosts } from '@/lib/data-utils'

const blog = await getRecentPersonalPosts(3)
---

<section
  class="flex flex-col gap-y-4"
  aria-labelledby="latest-posts-title"
  role="region"
>
  <div class="relative" aria-labelledby="latest-posts-title">
    <h2
      id="latest-posts-title"
      class="font-custom text-foreground text-2xl font-bold"
      title="my personal thoughts and experiences"
      aria-label="my personal thoughts and experiences"
    >
      My Personal Journey
    </h2>
    <p
      class="text-muted-foreground text-sm"
      aria-label="personal blog description"
    >
      Sharing my thoughts, experiences, and lessons learned along the way. These
      stories reflect who I am and what drives me forward.
    </p>
  </div>
  <ul class="flex flex-col gap-y-4">
    {
      blog.map((post, index) => (
        <li>
          <BlogCard entry={post} isLatest={index === 0} />
        </li>
      ))
    }
  </ul>
  <div class="flex justify-center" aria-label="explore personal journey">
    <Link
      href="/blog/personal"
      class={buttonVariants({ variant: 'ghost' }) + ' group'}
    >
      Explore my journey <span
        class="ml-1.5 transition-transform group-hover:translate-x-1"
        >&rarr;</span
      >
    </Link>
  </div>
</section>
