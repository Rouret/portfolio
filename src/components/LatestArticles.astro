---
import Link from '@/components/Link.astro'
import BlogCard from '@/components/react/blog-card'
import { buttonVariants } from '@/components/ui/button'
import { getRecentArticles } from '@/lib/data-utils'

const articles = await getRecentArticles(3)
---

<section
  class="flex flex-col gap-y-4"
  aria-labelledby="latest-posts-title"
  role="region"
>
  <div class="relative" aria-labelledby="latest-posts-title">
    <h2
      id="latest-posts-title"
      class="font-custom text-foreground text-2xl font-bold"
      title="latest writing"
      aria-label="latest writing"
    >
      Latest Writing
    </h2>
    <p class="text-muted-foreground text-sm" aria-label="blog description">
      Technical discoveries and personal reflections, sharing what I learn
      along the way.
    </p>
  </div>
  <ul class="flex flex-col gap-y-4">
    {
      articles.map((post, index) => (
        <li>
          <BlogCard entry={post} isLatest={index === 0} />
        </li>
      ))
    }
  </ul>
  <div class="flex justify-center" aria-label="discover more writing">
    <Link href="/blog" class={buttonVariants({ variant: 'ghost' }) + ' group'}>
      Discover more learnings <span
        class="ml-1.5 transition-transform group-hover:translate-x-1"
        >&rarr;</span
      >
    </Link>
  </div>
</section>
