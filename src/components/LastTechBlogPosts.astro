---
import Link from '@/components/Link.astro'
import BlogCard from '@/components/react/blog-card'
import { buttonVariants } from '@/components/ui/button'
import { getRecentTechPosts } from '@/lib/hashnode'

const blog = await getRecentTechPosts(3)
---

<section
  class="flex flex-col gap-y-4"
  aria-labelledby="latest-posts-title"
  role="region"
>
  <div class="relative" aria-labelledby="latest-posts-title">
    <h2
      id="latest-posts-title"
      class="font-custom text-foreground text-2xl font-bold"
      title="sharing technical knowledge and discoveries"
      aria-label="sharing technical knowledge and discoveries"
    >
      Latest Tech Blog Posts
    </h2>
    <p class="text-muted-foreground text-sm" aria-label="tech blog description">
      I believe in learning by sharing. Here's what I've discovered,
      experimented with, and learned along my technical journey.
    </p>
  </div>
  <ul class="flex flex-col gap-y-4">
    {
      blog.map((post, index) => (
        <li>
          <BlogCard entry={post} isLatest={index === 0} />
        </li>
      ))
    }
  </ul>
  <div
    class="flex justify-center"
    aria-label="discover more technical learnings"
  >
    <Link
      href="/blog"
      class={buttonVariants({ variant: 'ghost' }) + ' group'}
    >
      Discover more learnings <span
        class="ml-1.5 transition-transform group-hover:translate-x-1"
        >&rarr;</span
      >
    </Link>
  </div>
</section>
