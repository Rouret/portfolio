---
import { projectLabel } from '@/lib/data-utils'
import type { CollectionEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'
import ScreenshotPanel from '@/components/ScreenshotPanel.astro'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
---

<a
  href={`/projects/${project.id}`}
  class="group border-border bg-card grid overflow-hidden rounded-2xl border transition-shadow hover:shadow-lg md:grid-cols-[2fr_3fr]"
>
  <div class="flex flex-col gap-4 p-6 sm:p-8">
    <h3 class="text-foreground flex flex-wrap items-baseline gap-x-3 text-2xl font-medium">
      {project.data.name}
      <span class="text-muted-foreground text-sm font-normal">
        {projectLabel(project)}
      </span>
    </h3>
    <p class="text-muted-foreground">{project.data.pitch}</p>
    <span class="text-foreground mt-auto inline-flex items-center gap-2 pt-4 text-sm font-medium">
      Case study
      <span class="bg-foreground text-background grid size-7 place-items-center rounded-full transition-transform group-hover:rotate-45">
        <Icon name="lucide:arrow-up-right" class="size-4" />
      </span>
    </span>
  </div>
  <ScreenshotPanel
    src={project.data.image}
    alt={project.data.name}
    imageClass="transition-transform duration-500 group-hover:scale-[1.03]"
  />
</a>
