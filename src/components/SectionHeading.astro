---
import { cn } from '@/lib/utils'

interface Props {
  as?: 'h1' | 'h2'
  class?: string
}

const { as: Tag = 'h2', class: className } = Astro.props
const size = { h1: 'text-5xl sm:text-7xl', h2: 'text-4xl sm:text-6xl' }[Tag]
---

<Tag class={cn('font-custom text-foreground font-bold', size, className)}>
  <slot />
</Tag>
