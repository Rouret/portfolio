---
import ArticleCover from '@/components/ArticleCover.astro'
import type { ArticleWithSlug } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'a'> {
  article: ArticleWithSlug
  featured?: boolean
}

const { article, featured = false, class: className, ...attrs } = Astro.props
const { title, description, date, tags } = article.data
const meta = [featured ? 'Featured' : tags?.[0], formatDate(date)].filter(Boolean).join(', ')
---

<a
  href={`/articles/${article.slug}`}
  class:list={['group', featured ? 'grid gap-6 md:grid-cols-2' : 'flex flex-col gap-3', className]}
  {...attrs}
>
  <ArticleCover article={article} size={featured ? 'lg' : 'sm'} class={featured ? 'rounded-2xl' : 'rounded-xl'} />
  <div class:list={['flex flex-col gap-3', featured && 'justify-center']}>
    <p class="text-muted-foreground font-mono text-xs">{meta}</p>
    <h3 class:list={['text-foreground font-medium group-hover:underline', featured && 'text-2xl']}>{title}</h3>
    {featured && <p class="text-muted-foreground">{description}</p>}
  </div>
</a>
