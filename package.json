{
  "engines": {
    "node": ">=22.23.4"
  },
  "browserslist": "> 0.5%, last 2 versions, Firefox ESR, not dead",
  "keywords": [
    "astro",
    "blog",
    "portfolio",
    "website"
  ],
  "name": "lucas-rouret.fr",
  "type": "module",
  "version": "1.1.0",
  "private": false,
  "scripts": {
    "dev": "astro dev --port 3010",
    "start": "astro preview",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prettier": "prettier --write **/*.{ts,tsx,css,astro} --ignore-path .gitignore"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vercel": "^11.0.20",
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@fingerprintjs/fingerprintjs": "^5.3.0",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/mdi": "^1.2.3",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/routing-utils": "^6.6.1",
    "@vercel/speed-insights": "^2.1.0",
    "astro": "^7.4.7",
    "astro-expressive-code": "^0.44.3",
    "astro-icon": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.10.1",
    "fuse.js": "^7.5.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "rehype-document": "^7.0.3",
    "rehype-external-links": "^3.0.0",
    "rehype-pretty-code": "^0.14.6",
    "remark-emoji": "^5.0.2",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@types/lodash.debounce": "^4.0.9",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-astro-organize-imports": "^0.4.14",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss",
      "prettier-plugin-astro-organize-imports"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
